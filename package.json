{
  "name": "cfdgts",
  "version": "0.1.1",
  "description": "JavaScript Implementation of Context Free using Chevrotain parser",
  "main": "dist/contextfree.js",
  "types": "dist/contextfree.d.ts",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:parser && npm run build:ts && npm run build:browser",
    "build:parser": "node generate.js",
    "build:ts": "tsc",
    "build:browser": "node build-browser.js",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "dev": "vite",
    "build:editor": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "contextfree",
    "graphics",
    "parser"
  ],
  "author": "alpicola",
  "license": "MIT",
  "dependencies": {
    "chevrotain": "^11.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.0",
    "vite": "^7.3.0"
  }
}
