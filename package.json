{
  "name": "cfdgts",
  "version": "0.1.1",
  "description": "JavaScript Implementation of Context Free using Chevrotain parser",
  "main": "dist/contextfree.js",
  "types": "dist/contextfree.d.ts",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:parser && npm run build:ts && npm run build:browser",
    "build:parser": "node generate.js",
    "build:ts": "tsc",
    "build:browser": "node build-browser.js",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "contextfree",
    "graphics",
    "parser"
  ],
  "author": "alpicola",
  "license": "MIT",
  "dependencies": {
    "chevrotain": "^11.0.3"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
