# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore, with the addition of
# "#!include" directives (which insert the entries of the given .gitignore-style
# file at that point).
#
# For more information, run:
#   $ gcloud topic gcloudignore
#
.gcloudignore
# If you would like to upload your .git directory, .gitignore file or files
# from your .gitignore file, remove the corresponding line
# below:
.git
.gitignore

# Node.js dependencies (will be installed during build):
node_modules/

# TypeScript source files (only source, not config - configs are needed for build)
src/
editor/src/

# Build artifacts that will be regenerated during gcp-build
dist/
public/

# Development and IDE files
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test files
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Documentation (optional, can be excluded to reduce upload size)
*.md
!DEPLOYMENT.md

# Demo/example HTML files (not needed for production)
index.html

