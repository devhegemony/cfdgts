{
  "compilerOptions": {
    "target": "ES5",
    "module": "none",
    "lib": ["ES5", "DOM"],
    "outDir": "./",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "contextfree.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.js"
  ]
}
